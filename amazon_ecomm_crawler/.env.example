AMAZON_BASE_URL=https://www.amazon.in
AMAZON_SEARCH_INDEX=electronics
AMAZON_ROOT_NODE=976419031

# Cities to crawl (array of {slug, name, state, pincode})
CITIES_FILE=cities.json

MONGO_URI=mongodb://localhost:27018
MONGO_DB=amazon_ecomm

# Seconds between requests (random in this range)
CRAWL_MIN_DELAY=2
CRAWL_MAX_DELAY=5
CRAWL_MAX_RETRIES=3

# POC limits per subcategory (0 = no limit)
CRAWL_MAX_PAGES=2
CRAWL_MAX_PRODUCTS=20
CRAWL_MAX_REVIEWS=10

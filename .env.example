# Copy to .env and fill in. Used by docker-compose and by local runs.
# Never commit .env. Docker compose overrides MONGO_URI and BACKEND_URL for containers.

# ---- Gemini (agent) ----
GOOGLE_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---- MongoDB ----
# Local runs: the crawler's MongoDB on the host. Compose sets mongodb://mongo:27017 inside containers.
MONGO_URI=mongodb://localhost:27018
MONGO_DB=amazon_ecomm
CHAT_DB=chatbot

# ---- Amazon crawler ----
AMAZON_BASE_URL=https://www.amazon.in
AMAZON_SEARCH_INDEX=electronics
AMAZON_ROOT_NODE=976419031
CRAWL_MIN_DELAY=2
CRAWL_MAX_DELAY=5
CRAWL_MAX_RETRIES=3
CRAWL_MAX_PAGES=2
CRAWL_MAX_PRODUCTS=20
CRAWL_MAX_REVIEWS=10
STALE_HOURS=48

# Browser fallback (Playwright) when HTTP can't pass the bot check or set the pincode.
# auto = only when HTTP fails, always = every new session, off = never.
BROWSER_FALLBACK=auto
# false opens a visible window so you can solve an image captcha by hand (local runs only).
BROWSER_HEADLESS=true
# Optional: use an installed Chrome instead of Playwright's Chromium, e.g. /usr/bin/google-chrome
BROWSER_EXECUTABLE=
BROWSER_MANUAL_WAIT=180
# Max Chromium instances at once (each takes 1-2 cores and ~600 MB for ~30 s)
BROWSER_MAX_CONCURRENT=2

# ---- Crawl workers (Redis + RQ) ----
# Local runs: the compose Redis on the host. Compose sets redis://redis:6379/0 inside containers.
REDIS_URL=redis://localhost:6380/0
CRAWL_QUEUE=crawl
# Worker processes inside the crawler-worker container (all share its 2 CPU / 12 GB limit)
CRAWL_WORKERS=4
# Cities each run crawls (slug, name or pincode; space or comma separated). Empty = all 10 in cities.json.
CRAWL_CITIES=
CRAWL_JOB_TIMEOUT=10800

# ---- Backend (FastAPI) ----
# Used by the Django frontend to reach the backend. Compose sets http://backend:8000 inside containers.
BACKEND_URL=http://127.0.0.1:8000

# ---- Frontend (Django) ----
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
